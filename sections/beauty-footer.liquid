
<footer class="bs-footer">
<div class="bh-wrap bs-service"><div><strong>{{ section.settings.benefit_1 | escape }}</strong><p>{{ section.settings.benefit_text_1 | escape }}</p></div><div><strong>{{ section.settings.benefit_2 | escape }}</strong><p>{{ section.settings.benefit_text_2 | escape }}</p></div><div><strong>{{ section.settings.benefit_3 | escape }}</strong><p>{{ section.settings.benefit_text_3 | escape }}</p></div></div>
<div class="bh-wrap bs-newsletter"><div><p class="bh-eyebrow">{{ section.settings.newsletter_label | escape }}</p><h2>{{ section.settings.newsletter_heading | escape }}</h2><p>{{ section.settings.newsletter_text | escape }}</p></div>
{% assign form_id = 'BeautyNewsletter-' | append: section.id %}{% form 'customer', id: form_id %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="Email-{{ section.id }}">{{ 'beauty_store.email' | t }}</label><div class="bs-email-row"><input id="Email-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required><button type="submit">{{ 'beauty_store.subscribe' | t }}</button></div>{% if form.posted_successfully? %}<p role="status">{{ 'beauty_store.subscribed' | t }}</p>{% endif %}{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}<p class="bs-consent">{{ section.settings.consent | escape }}{% if shop.privacy_policy.url != blank %} <a href="{{ shop.privacy_policy.url }}">{{ 'beauty_store.privacy' | t }}</a>{% endif %}</p>{% endform %}</div>
<div class="bh-wrap bs-footer-columns"><section><h2>{{ 'beauty_store.help' | t }}</h2><ul>{% if section.settings.contact_url != blank %}<li><a href="{{ section.settings.contact_url }}">{{ 'beauty_store.contact' | t }}</a></li>{% endif %}{% if shop.shipping_policy.url != blank %}<li><a href="{{ shop.shipping_policy.url }}">{{ 'beauty_store.delivery' | t }}</a></li>{% endif %}{% if shop.refund_policy.url != blank %}<li><a href="{{ shop.refund_policy.url }}">{{ 'beauty_store.returns' | t }}</a></li>{% endif %}{% if shop.privacy_policy.url != blank %}<li><a href="{{ shop.privacy_policy.url }}">{{ 'beauty_store.privacy' | t }}</a></li>{% endif %}</ul><p>{{ section.settings.help_text | escape }}</p></section>
<section><h2>{{ 'beauty_store.about' | t }}</h2><p>{{ section.settings.about_text | escape }}</p>{% if section.settings.about_url != blank %}<a href="{{ section.settings.about_url }}">{{ 'beauty_store.our_story' | t }}</a>{% endif %}</section>
<section><h2>{{ 'beauty_store.shopping' | t }}</h2><ul><li><a href="{{ routes.search_url }}?type=product&amp;q=tag%3Anew-arrivals">New In</a></li><li><a href="{{ routes.search_url }}?type=product&amp;q=tag%3Askincare">Skincare</a></li><li><a href="{{ routes.search_url }}?type=product&amp;q=tag%3Amakeup">Makeup</a></li><li><a href="{{ routes.search_url }}?type=product&amp;q=tag%3Abody-care">Body</a></li><li><a href="{{ routes.search_url }}?type=product&amp;q=tag%3Ahaircare">Hair</a></li><li><a href="{{ routes.search_url }}?type=product&amp;q=tag%3Afragrance">Fragrance</a></li><li><a href="{{ routes.search_url }}?type=product&amp;q=tag%3Asale">Sale</a></li></ul></section><section><h2>{{ 'beauty_store.social' | t }}</h2><ul>{% if section.settings.instagram != blank %}<li><a href="{{ section.settings.instagram }}">Instagram</a></li>{% endif %}{% if section.settings.pinterest != blank %}<li><a href="{{ section.settings.pinterest }}">Pinterest</a></li>{% endif %}{% if section.settings.tiktok != blank %}<li><a href="{{ section.settings.tiktok }}">TikTok</a></li>{% endif %}</ul><p>{{ section.settings.social_text | escape }}</p></section></div>
<div class="bh-wrap bs-footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>{% if shop.terms_of_service.url != blank %}<a href="{{ shop.terms_of_service.url }}">{{ 'beauty_store.terms' | t }}</a>{% endif %}</div></footer>
