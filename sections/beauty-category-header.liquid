{{ 'beauty-home.css' | asset_url | stylesheet_tag }}
{%- assign category_image = collection.image | default: collection.products.first.featured_image -%}

<nav class="bh-wrap d-crumbs" aria-label="{{ 'beauty_store.breadcrumb' | t }}">
  <a href="{{ routes.root_url }}">{{ 'beauty_store.home' | t }}</a>
  <span aria-hidden="true">/</span>
  <a href="{{ routes.collections_url }}">{{ 'beauty_store.shop' | t }}</a>
  <span aria-hidden="true">/</span>
  {{ collection.title | escape }}
</nav>

<section class="bs-category bh-wrap">
  <div>
    {%- if section.settings.eyebrow != blank -%}
      <p class="bh-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1>{{ collection.title | escape }}</h1>
    <div>{{ collection.description }}</div>
    <nav aria-label="{{ 'beauty_store.subcategories' | t }}" class="bs-chips">
      {%- for type in collection.all_types -%}
        {%- if type != blank -%}
          <a href="{{ collection.url }}?filter.p.product_type={{ type | url_encode }}">{{ type | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </div>
  {%- if category_image -%}
    {{ category_image | image_url: width: 900 | image_tag: widths: '450,700,900', sizes: '(max-width: 749px) 100vw, 40vw', loading: 'eager' }}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Beauty category header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Category" }
  ],
  "presets": [{ "name": "Beauty category header" }]
}
{% endschema %}
