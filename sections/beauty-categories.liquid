{{ 'beauty-home.css' | asset_url | stylesheet_tag }}
<section class="bh-wrap bh-categories"><header class="bh-heading"><h2>{{ section.settings.heading | escape }}</h2></header><div class="bh-tiles">{% for block in section.blocks %}<a class="bh-tile" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><div>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy' }}{% else %}<img src="{{ block.settings.image_url }}" alt="{{ block.settings.heading | escape }}" width="600" height="750" loading="lazy">{% endif %}</div><h3>{{ block.settings.heading | escape }} <span aria-hidden="true">↗</span></h3></a>{% endfor %}</div></section>
{% schema %}
{
  "name": "Beauty category tiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore your beauty world"
    }
  ],
  "presets": [
    {
      "name": "Beauty category tiles"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Title",
          "default": "Skincare"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "Fallback image URL"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
