{{ 'beauty-home.css' | asset_url | stylesheet_tag }}
<section class="bh-wrap bh-benefits" aria-label="{{ section.settings.heading | escape }}">
  {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}>
      <span class="bh-benefit-icon" aria-hidden="true">{{ block.settings.symbol | escape }}</span>
      <h2>{{ block.settings.heading | escape }}</h2>
      <p>{{ block.settings.body | escape }}</p>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Beauty service bar",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section label", "default": "Our service" }
  ],
  "presets": [{ "name": "Beauty service bar" }],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "symbol", "label": "Symbol", "default": "✓" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free delivery" },
        { "type": "text", "id": "body", "label": "Description", "default": "On every order in this demo storefront." }
      ]
    }
  ]
}
{% endschema %}
