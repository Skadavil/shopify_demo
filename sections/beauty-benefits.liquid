{{ 'beauty-home.css' | asset_url | stylesheet_tag }}
<section class="bh-wrap bh-benefits" aria-label="{{ section.settings.heading | escape }}">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><span class="bh-benefit-icon" aria-hidden="true">{{ block.settings.symbol | escape }}</span><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.body | escape }}</p></div>{% endfor %}</section>
{% schema %}
{
  "name": "Beauty service benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section label",
      "default": "Why shop with us"
    }
  ],
  "presets": [
    {
      "name": "Beauty service benefits"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "symbol",
          "label": "Symbol",
          "default": "\u25c7"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Discover more"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Description",
          "default": "Explore your next beauty favourite."
        }
      ]
    }
  ]
}
{% endschema %}
