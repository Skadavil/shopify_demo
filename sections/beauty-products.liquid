{{ 'beauty-home.css' | asset_url | stylesheet_tag }}
<section class="bh-wrap bh-products" aria-labelledby="bh-heading-{{ section.id }}">
  <header class="bh-heading">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="bh-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="bh-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.label != blank -%}
      <div class="bh-controls">
        <a href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{- section.settings.label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </header>

  <div class="bh-rail">
    <button type="button" data-bh-direction="-1" aria-label="{{ 'beauty_home.previous' | t }}">&#8249;</button>
    <button type="button" data-bh-direction="1" aria-label="{{ 'beauty_home.next' | t }}">&#8250;</button>
    <div class="bh-track" tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
    {%- for block in section.blocks -%}
      {%- assign item = block.settings.product -%}
      {%- if item != blank -%}
        <article class="bh-card" {{ block.shopify_attributes }}>
          <a href="{{ item.url }}">
            <div class="bh-card__image">
              {% render 'beauty-card-badges', product: item %}
              {%- if item.featured_image -%}
                {{ item.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(max-width: 749px) 62vw, 20vw' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            {% render 'beauty-card-info', product: item %}
            {% render 'beauty-card-price', product: item %}
          </a>
        </article>
      {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if request.design_mode -%}
    <p class="bh-editor-note">{{ 'beauty_home.select_products' | t }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Beauty product rail",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Discover" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New In" },
    { "type": "text", "id": "label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "View all link" }
  ],
  "presets": [{ "name": "Beauty product rail" }],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [{ "type": "product", "id": "product", "label": "Product" }]
    }
  ]
}
{% endschema %}
